<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System">
      <section name="DevExpress.LookAndFeel.Design.AppSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="ExchangeSystem.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  
  <connectionStrings>
    <add name="localhost_EXCHANGESYS_Connection" connectionString="XpoProvider=MSSqlServer;data source=93.158.238.134;user id=;password=;initial catalog=EXCHANGESYS;Persist Security Info=true" />
    <add name="localhost_EXCHANGESYS_Connection 1" connectionString="XpoProvider=MSSqlServer;data source=93.158.238.134;user id=;password=;initial catalog=EXCHANGESYS;Persist Security Info=true" />
    <add name="localhost_EXCHANGESYS_Connection 2" connectionString="XpoProvider=MSSqlServer;data source=93.158.238.134;user id=;password=;initial catalog=EXCHANGESYS;Persist Security Info=true" />
    <add name="localhost_ExSyAccounts_Connection" connectionString="XpoProvider=MSSqlServer;data source=93.158.238.134;user id=;password=;initial catalog=ExSyAccounts;Persist Security Info=true" />
    <add name="localhost_ContractDB_Connection" connectionString="XpoProvider=MSSqlServer;data source=93.158.238.134;user id=;password=;initial catalog=ContractDB;Persist Security Info=true" />
    <add name="localhost_EXCHANGESYS_Connection 3" connectionString="XpoProvider=MSSqlServer;data source=93.158.238.134;user id=;password=;initial catalog=EXCHANGESYS;Persist Security Info=true" />
    <add name="localhost_ExSyAccounts_Connection 1" connectionString="XpoProvider=MSSqlServer;data source=93.158.238.134;user id=new_admin;password=theartof1980@_coding;initial catalog=ExSyAccounts;Persist Security Info=true;Encrypt=false;TrustServerCertificate=true" />
    <add name="ExchangeSystem.My.MySettings.EXCHANGESYSConnectionString" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=EXCHANGESYS2026;Integrated Security=True" providerName="System.Data.SqlClient" />
    <add name="ExchangeSystem.My.MySettings.EXCHANGESYSConnectionString1" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=EXCHANGESYS2026;Integrated Security=True" providerName="System.Data.SqlClient" />
    <add name="ExchangeSystem.My.MySettings.SqlConnection1" connectionString="Data Source=93.158.238.134;Initial Catalog=EXCHANGESYS;Password=theartof1980@_coding;Persist Security Info=True;User ID=sa;" providerName="Devart.Data.SqlServer" />
    <add name="ExchangeSystem.My.MySettings.DevartCon" connectionString="Data Source=93.158.238.134;Initial Catalog=EXCHANGESYS;Password=theartof1980@_coding;Persist Security Info=True;User ID=sa;" providerName="Devart.Data.SqlServer" />
  </connectionStrings>
  <applicationSettings>
    <DevExpress.LookAndFeel.Design.AppSettings>
      <setting name="DefaultAppSkin" serializeAs="String">
        <value>Skin/WXI</value>
      </setting>
      <setting name="DefaultPalette" serializeAs="String">
        <value>Calmness</value>
      </setting>
      <setting name="TouchUI" serializeAs="String">
        <value></value>
      </setting>
      <setting name="CompactUI" serializeAs="String">
        <value></value>
      </setting>
      <setting name="TouchScaleFactor" serializeAs="String">
        <value></value>
      </setting>
      <setting name="DirectX" serializeAs="String">
        <value></value>
      </setting>
      <setting name="RegisterUserSkins" serializeAs="String">
        <value></value>
      </setting>
      <setting name="RegisterBonusSkins" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="FontBehavior" serializeAs="String">
        <value></value>
      </setting>
      <setting name="DefaultAppFont" serializeAs="String">
        <value>Droid Arabic Kufi;8.25</value>
