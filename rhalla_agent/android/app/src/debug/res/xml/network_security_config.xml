<?xml version="1.0" encoding="utf-8"?>
<!--
  يسمح بـ HTTP الصريح أثناء التطوير فقط — هذا الملف في مجموعة مصادر debug،
  فلا يدخل بناء الإصدار إطلاقاً.

  10.0.2.2 هو عنوان جهاز المضيف كما يراه محاكي Android.

  192.168.1.10 هو عنوان جهاز التطوير على شبكة Wi-Fi المحلية، للاختبار على
  هاتف حقيقي متصل بنفس الشبكة. العنوان مكتوب صراحةً ولم نفتح base-config:
  الإبقاء على `cleartextTrafficPermitted="false"` في الأساس يعني أن أي عنوان
  آخر يظل محجوباً حتى في بناء debug.

  إن تغيّر عنوان الجهاز (DHCP) فحدّثه هنا وأعد البناء — وهو نفس ما يلزم على
  أي حال، لأن API_BASE يُثبَّت وقت الترجمة عبر وسيط dart-define.

  ملاحظة لمن يحرّر هذا الملف: XML يمنع شرطتين متتاليتين داخل التعليق، فلا
  تكتب اسم الوسيط ببادئته — البناء يفشل عندها في mergeDebugResources برسالة
  «The string is not permitted within comments».
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">192.168.1.10</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
