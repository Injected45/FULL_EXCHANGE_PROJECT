<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- مطلوبة في نسخة الإصدار. كانت معلنة في src/debug و src/profile فقط،
         وهما لا يدخلان الإصدار — فكانت نسخة الإصدار بلا شبكة إطلاقاً. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- الرسائل الصوتية. يُطلب الإذن **عند أول تسجيل** لا عند فتح التطبيق
         (البند 46): طلبٌ عند الإقلاع بلا سبب ظاهر يُرفَض غالباً، ثم لا يعود
         النظام يسأل. ورفضُه لا يعطّل شيئاً غير التسجيل. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- الميكروفون ليس شرطاً لتشغيل التطبيق: بدون هذا يُخفي Google Play
         التطبيق عن الأجهزة بلا ميكروفون (لوحيّات مثلاً)، وهي أجهزة يعمل
         عليها كل شيء عدا التسجيل. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <!-- مسحُ رمز QR لتفعيل الموظف. يُطلب الإذن عند فتح الماسح لا عند
         الإقلاع، ورفضُه لا يمنع التفعيل: الإدخالُ اليدويّ للكود باقٍ
         طريقاً كاملاً لا بديلاً ناقصاً. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- المصادقة الحيويّة لقفل التطبيق بعد الخمول.
         ⚠ `USE_BIOMETRIC` وحدَه (API 28+) — و`USE_FINGERPRINT` مهجورٌ
         ولا يُضاف: Play يُنبّه على الأذونات المهجورة في المراجعة.
         ولا تُخزَّن بياناتٌ حيويّة: النظامُ يُعيد نجاحاً أو فشلاً. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- والكاميرا ليست شرطاً لتشغيل التطبيق — كالميكروفون تماماً:
         بدون هذا يُخفي Google Play التطبيق عن كل جهازٍ بلا كاميرا. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- ⚠⚠ استثناءُ HTTP مؤقّت — يُحذف قبل الرفع إلى المتجرين.
         خادمُ الإنتاج بلا TLS، وtargetSdk 36 يحجب HTTP تلقائياً، فبناءُ
         الإصدار كان لا يفتح مقبساً أصلاً: «تعذّر الاتصال بالخادم» على
         شبكةٍ سليمة. والاستثناءُ مقصورٌ على عنوانٍ واحد — انظر الملف. -->
    <!-- ⚠⚠ لا يُنسخ من هذا التطبيق شيء — لا سحابةً ولا إلى هاتفٍ آخر.

         ما يُخزَّن كلُّه حسّاس: رمزُ الجلسة، ومعرّفُ الجهاز المربوط،
         وصلاحياتُ الموظف. والنسخُ التلقائيّ يرفعه إلى Google Drive ويُتيح
         استعادتَه على **هاتفٍ آخر** — وذلك ينقض ربطَ الجهاز الذي يقوم
         عليه أمنُ الحسابين.

         ⚠ وقد سبّب عطلاً حقيقياً: مفتاحُ Keystore لا يُنسخ، فتُستعاد
         تفضيلاتٌ مشفَّرة إلى جهازٍ لا يملك مفتاحَها فتُخفق القراءة — وهو
         ما جمّد التطبيق على شاشة البداية (9 سبتمبر 2026).

         والملفّان يبقيان دفاعاً ثانياً لمن يُعيد allowBackup يوماً.

         ⚠⚠ وإعدادُ الشبكة **متغيّر**، وافتراضيُّه الصارم: netSecConfig
         تُملأ من Gradle بـnetwork_security_strict (TLS إلزاميّ)، ولا
         تصير الاستثناءَ إلّا بـallowCleartext=true صراحةً. وحارسٌ في
         build.gradle.kts يرفض بناءَ حزمةِ متجرٍ وهو مُفعَّل. -->
    <application
        android:label="الرحالة | الوكيل"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/${netSecConfig}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
