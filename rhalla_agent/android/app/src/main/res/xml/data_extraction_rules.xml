<?xml version="1.0" encoding="utf-8"?>
<!--
  ════════════════════════════════════════════════════════════════════════════
   ⚠ لا يُنسخ من هذا التطبيق شيء — لا إلى السحابة ولا إلى هاتفٍ آخر
  ════════════════════════════════════════════════════════════════════════════

  أندرويد 12 فما فوق يقرأ هذا الملف؛ وما دونه يقرأ `full_backup_content`.
  والاثنان مُعلنان في المانيفست لأن الجهازَين موجودان في يد المستخدمين.

  ── ولماذا المنعُ كاملٌ لا انتقائيّ ───────────────────────────────────────

  ⚠ **ما يُخزّنه هذا التطبيق كلُّه حسّاس**: رمزُ جلسة الوكيل، ورمزُ جلسة
  الموظف، ومعرّفُ الجهاز المربوط، وملفُّ الموظف وصلاحياتُه. ولا شيءَ فيه
  يستحقّ النسخ — لا تفضيلاتِ عرضٍ ولا مسوّدات.

  والنسخُ الاحتياطيّ التلقائيّ يرفع ذلك إلى Google Drive الخاصّ بالمستخدم:
  خارجَ الجهاز، وخارجَ سيطرة التطبيق، وقابلاً للاستعادة على **هاتفٍ آخر**.
  وذلك يناقض ربطَ الجهاز الذي يقوم عليه أمنُ الحسابين معاً.

  ── ⚠ وقد تسبّب في عطلٍ حقيقيّ لا في خطرٍ نظريّ ─────────────────────────

  التخزينُ الآمن مشفَّرٌ بمفتاحٍ في Android Keystore، **والمفتاحُ لا يُنسخ**.
  فالاستعادةُ تُعيد ملفَّ التفضيلات المشفَّر إلى جهازٍ مفتاحُه مختلف، فتُخفق
  فكُّ الشفرة وتُرمى من `read` نفسِها — وهو ما جمّد التطبيق على شاشة البداية
  (9 سبتمبر 2026). الحراسةُ في الشيفرة عالجت العَرَض؛ وهذا يمنع السبب.

  ⚠ والثمنُ مقبول: من غيّر هاتفه يُفعّل من جديد — وهو ما يجب أن يحدث في
  تطبيقٍ يربط حساباً بجهاز.
  ════════════════════════════════════════════════════════════════════════════
-->
<data-extraction-rules>

    <!-- النسخُ السحابيّ (Google Drive). -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>

    <!-- النقلُ المباشر إلى هاتفٍ جديد (Device-to-Device). -->
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>

</data-extraction-rules>
