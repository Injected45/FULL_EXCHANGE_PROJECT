<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠ نظيرُ `data_extraction_rules.xml` لأندرويد 11 فما دون.
  الشرحُ الكامل هناك — ولا يُعدَّل أحدُهما دون الآخر، وإلّا صار الجهازُ
  الأقدم مكشوفاً بينما يُظنّ الأمرُ محسوماً.

  و`allowBackup="false"` في المانيفست يُغني عن الاثنين، لكنه يُترك إليهما
  دفاعاً ثانياً: من يُعيد `allowBackup` يوماً يجد الاستثناءات قائمة.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
