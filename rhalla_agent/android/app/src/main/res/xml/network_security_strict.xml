<?xml version="1.0" encoding="utf-8"?>
<!--
  ════════════════════════════════════════════════════════════════════════════
   الإعدادُ الافتراضيّ: **TLS إلزاميّ، بلا استثناءٍ واحد**
  ════════════════════════════════════════════════════════════════════════════

  هذا ما يُبنى به التطبيق ما لم يُطلب غيرُه صراحةً، وهو ما يُشحن إلى
  Google Play و App Store — انظر الحارس في `android/app/build.gradle.kts`
  الذي يرفض بناءَ حزمةِ متجرٍ وفيها استثناءُ HTTP.

  ⚠ ولا يُضاف هنا عنوانٌ أبداً. الاستثناءُ المؤقّت — إن لزم للتجربة — في
  `network_security_config.xml`، ولا يُفعَّل إلّا بـ`-PallowCleartext=true`.
  ════════════════════════════════════════════════════════════════════════════
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
