<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠⚠ نقلٌ غير مشفَّر — وهو **عائقُ نشرٍ حقيقيّ، لا إعدادٌ نهائيّ.** ⚠⚠

  خادم الشركة اليوم `http://` بلا شهادة TLS، وأندرويد يمنع النصّ الصريح
  افتراضياً عند هذا الـ targetSdk. فبغير هذا الملفّ لا يفتح التطبيق الخادمَ
  إطلاقاً، ولا تظهر رسالةُ خطأٍ مفهومة — تبيضّ الشاشة فحسب.

  وما يمرّ في هذه القناة ليس تافهاً: **محادثات الوكلاء مع الإدارة، وكلماتُ
  مرور موظّفي الدعم، ورموزُ جلساتهم.** من يجلس على الشبكة نفسها يقرأها كلَّها.

  ولذلك هذا مقبولٌ في شبكة المكتب المغلقة وحدها. وقبل أن يُسلَّم التطبيق
  لموظّفٍ يعمل من بيته أو من مدينةٍ أخرى، **يجب** أن تُركَّب شهادة TLS على
  الخادم ويُحذف هذا الملفّ مع `usesCleartextTraffic` من المانيفست.

  وهو العائقُ نفسه المسجَّل على تطبيق الوكيل في CLAUDE.md، وللسبب نفسه:
  الحلُّ شهادةٌ على الخادم لا استثناءٌ في التطبيق.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
